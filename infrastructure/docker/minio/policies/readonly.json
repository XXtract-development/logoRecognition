{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:GetObjectVersion",
        "s3:GetObjectTagging",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::logo-*",
        "arn:aws:s3:::logo-*/*"
      ]
    }
  ]
}