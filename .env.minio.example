# MinIO Configuration - COPY TO .env.minio AND UPDATE VALUES
# SECURITY: Never commit actual credentials to version control

# MinIO Cluster Credentials (REQUIRED - No defaults for security)
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme123changeme
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme123changeme

# MinIO Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=logo-images
MINIO_REGION=us-east-1

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme

# CDN Configuration (AWS CloudFront)
CDN_DOMAIN=https://cdn.logorecognition.com
CLOUDFRONT_DISTRIBUTION_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Security Configuration
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,svg,pdf
CORS_ALLOWED_ORIGINS=https://logorecognition.com,https://app.logorecognition.com
RATE_LIMIT_UPLOADS_PER_MINUTE=60

# Performance Configuration
MINIO_POOL_CONNECTIONS=50
MULTIPART_THRESHOLD_MB=5
MULTIPART_CHUNKSIZE_MB=10
MAX_CONCURRENT_UPLOADS=10
CACHE_TTL_SECONDS=3600

# Monitoring Configuration
PROMETHEUS_ENABLED=true
TRACING_ENABLED=true
METRICS_PORT=9290