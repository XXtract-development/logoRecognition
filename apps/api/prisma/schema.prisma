// Prisma Schema for Logo Recognition System
// Based on infrastructure/docker/postgres/init.sql
// Run: npx prisma generate && npx prisma db push

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public"), pg_trgm, btree_gin, btree_gist]
}

// ============================================
// CORE MODELS
// ============================================

/// Logo images with vector embeddings for similarity search
model LogoImage {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filename        String    @db.VarChar(255)
  storagePath     String    @map("storage_path") @db.VarChar(500)
  embedding       Unsupported("vector(512)")?
  metadata        Json      @default("{}")
  brandName       String?   @map("brand_name") @db.VarChar(255)
  confidenceScore Float?    @map("confidence_score")
  detectedAt      DateTime? @map("detected_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  trainingData TrainingData[]
  annotations  Annotation[]

  @@index([brandName])
  @@index([createdAt(sort: Desc)])
  @@map("logo_images")
}

/// Training data for model improvement
model TrainingData {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageId        String    @map("image_id") @db.Uuid
  label          String    @db.VarChar(255)
  confidence     Float?
  validated      Boolean   @default(false)
  holdout        Boolean   @default(false) @map("holdout")
  validationDate DateTime? @map("validation_date") @db.Timestamptz
  validatedBy    String?   @map("validated_by") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Artwork provenance (Epic 8, Story 8.6): { sourceFile, bbox, method, confidence }
  provenance     Json      @default("{}")
  /// Soft-delete flag (Epic 8, Story 8.6): false = deactivated (bad source)
  active         Boolean   @default(true)
  /// Path to the crop in MinIO (Epic 8, Story 8.6)
  cropPath       String?   @map("crop_path") @db.VarChar(1000)

  // Relations
  image LogoImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@index([label])
  @@index([validated])
  @@index([holdout])
  @@index([active])
  @@map("training_data")
}

/// ML model version tracking
model ModelVersion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version        String    @unique @db.VarChar(50)
  modelType      String    @map("model_type") @db.VarChar(100)
  accuracy       Float?
  precisionScore Float?    @map("precision_score")
  recallScore    Float?    @map("recall_score")
  f1Score        Float?    @map("f1_score")
  trainingDate   DateTime? @map("training_date") @db.Timestamptz
  isActive       Boolean   @default(false) @map("is_active")
  config         Json      @default("{}")
  metrics        Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([isActive])
  @@index([version])
  @@map("model_versions")
}

/// Search history for analytics
model SearchHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryVector  Unsupported("vector(512)")? @map("query_vector")
  resultsCount Int?     @map("results_count")
  searchTimeMs Float?   @map("search_time_ms")
  userId       String?  @map("user_id") @db.VarChar(255)
  sessionId    String?  @map("session_id") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("search_history")
}

// ============================================
// USER & AUTH MODELS
// ============================================

/// System users
model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  role           UserRole @default(USER)
  organizationId String?  @map("organization_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id])
  trainingBatches TrainingBatch[]
  annotations     Annotation[]
  recognitionLogs RecognitionLog[]

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

/// Organizations for multi-tenancy
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  users User[]

  @@map("organizations")
}

// ============================================
// TRAINING WORKFLOW MODELS
// ============================================

/// Training batch - groups uploaded images
model TrainingBatch {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String           @db.VarChar(255)
  status    TrainingStatus   @default(UPLOADING)
  fileCount Int              @default(0) @map("file_count")
  userId    String           @map("user_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user        User         @relation(fields: [userId], references: [id])
  annotations Annotation[]

  @@index([userId])
  @@index([status])
  @@map("training_batches")
}

enum TrainingStatus {
  UPLOADING
  PROCESSING
  ANNOTATING
  TRAINING
  COMPLETED
  FAILED
}

/// Individual annotations on images
model Annotation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageId    String   @map("image_id") @db.Uuid
  batchId    String?  @map("batch_id") @db.Uuid
  logoId     String?  @map("logo_id") @db.Uuid
  x          Int
  y          Int
  width      Int
  height     Int
  category   String?  @db.VarChar(100)
  value      String?  @db.VarChar(100)
  confidence Float?
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  image LogoImage      @relation(fields: [imageId], references: [id], onDelete: Cascade)
  batch TrainingBatch? @relation(fields: [batchId], references: [id])
  logo  Logo?          @relation(fields: [logoId], references: [id])
  user  User           @relation(fields: [createdBy], references: [id])

  @@index([imageId])
  @@index([batchId])
  @@index([logoId])
  @@map("annotations")
}

/// Logo definitions (category + value)
model Logo {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category            String   @db.VarChar(100)
  value               String   @db.VarChar(100)
  confidenceThreshold Float    @default(0.99) @map("confidence_threshold")
  trainingSamples     Int      @default(0) @map("training_samples")
  accuracy            Float?
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  annotations      Annotation[]
  embeddings       LogoEmbedding[]
  recognitionResults RecognitionResult[]
  referenceLogos     ReferenceLogo[]

  @@unique([category, value])
  @@index([category])
  @@index([isActive])
  @@map("logos")
}

/// Reference keurmerk logos (Epic 7, Story 7.3)
/// Curated library of official keurmerk artwork + variants. Consumed by
/// Epic 8 (template-matching) and 8.7 (synthesis): the storagePath structure
/// per code/variant is the contract there — do not change it.
model ReferenceLogo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  t3777Code    String   @map("t3777_code") @db.VarChar(100)
  variantLabel String   @map("variant_label") @db.VarChar(100)
  source       String?
  storagePath  String   @map("storage_path") @db.VarChar(500)
  // GS1-codelijstnaam (1:1 met GS1) die de code beschrijft, bv.
  // PackagingMarkedLabelAccreditationCode (T3777), NutritionalScore (Nutri-Score A–E),
  // DietTypeCode, GHSSymbolDescriptionCode, EU_consumerUsageLabelCodeList. (migratie 0010/0011)
  fieldType    String   @default("PackagingMarkedLabelAccreditationCode") @map("field_type") @db.VarChar(60)
  // GS1-declaratieveld (XML-element) voor de crosscheck, bv.
  // packagingMarkedLabelAccreditationCode, nutritionalScore, dietTypeCode.
  gs1Field     String?  @map("gs1_field") @db.VarChar(60)
  active       Boolean  @default(true)
  logoId       String?  @map("logo_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  logo       Logo?                @relation(fields: [logoId], references: [id])
  embeddings ReferenceEmbedding[]
  // Kandidaten die naar deze referentie zijn gepromoveerd (Story 13.2, AD-3).
  candidates ReferenceCandidate[]

  @@unique([t3777Code, variantLabel])
  @@index([t3777Code])
  @@map("reference_logos")
}

/// Reference keurmerk embeddings (Epic 8, Story 8.4)
/// One embedding per active reference variant, used to classify localised
/// crops via pgvector cosine. Deliberately separate from LogoEmbedding:
/// reference embeddings are model-independent and must not pollute logo search.
model ReferenceEmbedding {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceLogoId String   @map("reference_logo_id") @db.Uuid
  embedding       Unsupported("vector(512)")?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  referenceLogo ReferenceLogo @relation(fields: [referenceLogoId], references: [id], onDelete: Cascade)

  @@index([referenceLogoId])
  @@map("reference_embeddings")
}

/// Logo embeddings for vector search
model LogoEmbedding {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  logoId    String   @map("logo_id") @db.Uuid
  modelId   String   @map("model_id") @db.Uuid
  embedding Unsupported("vector(512)")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  logo Logo @relation(fields: [logoId], references: [id], onDelete: Cascade)

  @@index([logoId])
  @@map("logo_embeddings")
}

// ============================================
// RECOGNITION & FEEDBACK MODELS
// ============================================

/// Recognition request logs
model RecognitionLog {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId           String   @map("request_id") @db.VarChar(100)
  userId              String?  @map("user_id") @db.Uuid
  modelId             String?  @map("model_id") @db.Uuid
  imageHash           String?  @map("image_hash") @db.VarChar(64)
  confidenceThreshold Float?   @map("confidence_threshold")
  processingTimeMs    Int?     @map("processing_time_ms")
  detectionCount      Int      @default(0) @map("detection_count")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user    User?               @relation(fields: [userId], references: [id])
  results RecognitionResult[]
  feedback FeedbackEntry[]

  @@index([requestId])
  @@index([userId])
  @@index([imageHash])
  @@index([createdAt(sort: Desc)])
  @@map("recognition_logs")
}

/// Individual detection results
model RecognitionResult {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  logId      String   @map("log_id") @db.Uuid
  logoId     String?  @map("logo_id") @db.Uuid
  category   String   @db.VarChar(100)
  value      String   @db.VarChar(100)
  confidence Float
  x          Int
  y          Int
  width      Int
  height     Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  log  RecognitionLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  logo Logo?          @relation(fields: [logoId], references: [id])

  @@index([logId])
  @@index([logoId])
  @@map("recognition_results")
}

/// Feedback for self-learning
model FeedbackEntry {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  logId           String    @map("log_id") @db.Uuid
  predictedLogoId String?   @map("predicted_logo_id") @db.Uuid
  confidence      Float?
  correctLogoId   String?   @map("correct_logo_id") @db.Uuid
  validatedBy     String?   @map("validated_by") @db.Uuid
  validatedAt     DateTime? @map("validated_at") @db.Timestamptz
  incorporated    Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  log RecognitionLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@index([incorporated])
  @@map("feedback_queue")
}

// ============================================
// MONITORING MODELS
// ============================================

/// Query performance statistics
model QueryStats {
  id             Int      @id @default(autoincrement())
  queryHash      String   @map("query_hash") @db.VarChar(64)
  queryText      String?  @map("query_text")
  executionCount BigInt   @default(0) @map("execution_count")
  totalTimeMs    Float    @default(0) @map("total_time_ms")
  meanTimeMs     Float    @default(0) @map("mean_time_ms")
  maxTimeMs      Float    @default(0) @map("max_time_ms")
  lastExecuted   DateTime @default(now()) @map("last_executed") @db.Timestamptz

  @@unique([queryHash])
  @@map("query_stats")
}

/// Service health checks
model HealthCheck {
  id           Int      @id @default(autoincrement())
  serviceName  String   @map("service_name") @db.VarChar(100)
  status       String   @db.VarChar(20)
  responseTimeMs Float? @map("response_time_ms")
  details      Json     @default("{}")
  checkedAt    DateTime @default(now()) @map("checked_at") @db.Timestamptz

  @@index([serviceName])
  @@index([checkedAt(sort: Desc)])
  @@map("health_checks")
}

/// Backup history tracking
model BackupHistory {
  id              Int      @id @default(autoincrement())
  backupType      String   @map("backup_type") @db.VarChar(50)
  backupPath      String   @map("backup_path") @db.VarChar(500)
  sizeBytes       BigInt?  @map("size_bytes")
  durationSeconds Float?   @map("duration_seconds")
  status          String   @db.VarChar(20)
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)])
  @@map("backup_history")
}

// ============================================
// ARTWORK PIPELINE MODELS (Epic 8)
// ============================================

/// Artwork import run — tracks a batch import job (Epic 8, Story 8.1)
model ArtworkImportRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status         String    @default("running") @db.VarChar(20)
  gtins          Json      @default("[]")
  importedCount  Int       @default(0) @map("imported_count")
  skippedCount   Int       @default(0) @map("skipped_count")
  failedCount    Int       @default(0) @map("failed_count")
  heartbeatAt    DateTime  @default(now()) @map("heartbeat_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  items ArtworkImport[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("artwork_import_runs")
}

/// Individual artwork import record — one per media item (Epic 8, Story 8.1)
model ArtworkImport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gtin           String   @db.VarChar(50)
  gln            String?  @db.VarChar(50)
  mediaId        String   @map("media_id") @db.VarChar(255)
  fileName       String   @map("file_name") @db.VarChar(500)
  sourceLocation String   @map("source_location") @db.VarChar(1000)
  sha256Hash     String?  @map("sha256_hash") @db.VarChar(64)
  storagePath    String?  @map("storage_path") @db.VarChar(1000)
  mimeType       String?  @map("mime_type") @db.VarChar(100)
  status         String   @default("imported") @db.VarChar(20)
  failureReason  String?  @map("failure_reason")
  importRunId    String   @map("import_run_id") @db.Uuid
  pages          Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  run ArtworkImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@unique([mediaId])
  @@index([gtin])
  @@index([importRunId])
  @@index([status])
  @@map("artwork_imports")
}

// ============================================
// RETRAINING PIPELINE MODELS (Epic 9)
// ============================================

/// Persistent retraining trigger notification (Epic 9, Story 9.2)
/// Ensures offline data managers never miss a trigger (Socket.IO is volatile).
/// Also serves as the dedup source of truth alongside Redis.
model RetrainingNotification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  triggerId  String    @unique @map("trigger_id") @db.VarChar(128)
  reasons    String[]
  status     String    @default("unread") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  readAt     DateTime? @map("read_at") @db.Timestamptz

  @@index([status, createdAt(sort: Desc)])
  @@map("retraining_notifications")
}

/// Model activation audit log (Epic 9, Story 9.5)
/// Records every human-approved activation with user + timestamp for compliance.
model ModelActivationLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelVersionId  String    @map("model_version_id") @db.Uuid
  userId          String    @map("user_id") @db.VarChar(255)
  activatedAt     DateTime  @default(now()) @map("activated_at") @db.Timestamptz
  triggeredBy     String    @map("triggered_by") @db.VarChar(50)
  batchId         String?   @map("batch_id") @db.Uuid

  @@index([modelVersionId])
  @@index([activatedAt(sort: Desc)])
  @@map("model_activation_logs")
}

/// Artwork review item — for 8.5 crosscheck routing (Epic 8, Story 8.5)
model ArtworkReviewItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gtin        String   @db.VarChar(50)
  t3777Code   String   @map("t3777_code") @db.VarChar(100)
  cropPath    String?  @map("crop_path") @db.VarChar(1000)
  bbox        Json     @default("{}")
  confidence  Float?
  method      String?  @db.VarChar(50)
  reason      String
  sourceFile  String?  @map("source_file") @db.VarChar(500)
  status      String   @default("open") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([gtin])
  @@index([status])
  @@index([t3777Code])
  @@map("artwork_review_items")
}

// ============================================
// REFERENTIE-VLIEGWIEL MODELS (Epic 13, Story 13.2)
// ============================================

/// Kandidaat-referentie in de nominatie-fase van het referentie-vliegwiel
/// (Story 13.2, AD-3/AD-12/AD-16). Een dubbel bevestigde detectie (crosscheck,
/// kruischeck, bootstrap of reviewstation-accept) wordt hier genomineerd; de
/// batch-/poort-/promotielus (13.4/13.5) maakt er pas later een actieve
/// referentie van. Uniciteit op (contentHash, t3777Code) voorkomt duplicaten
/// bij herverwerking (AD-12). De status volgt de status-machine uit AD-16.
model ReferenceCandidate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  t3777Code         String   @map("t3777_code") @db.VarChar(100)
  // Status-machine (AD-16): candidate → in_batch → promoted | rejected
  // (+ terugkeer-overgangen). Geen Prisma-enum (patroon ArtworkReviewItem.status).
  status            String   @default("candidate") @db.VarChar(20)
  // Herkomst-enum: crosscheck | kruischeck | bootstrap | review (AD-13).
  origin            String   @db.VarChar(20)
  // Canonieke inhouds-hash uit /ml/phash (AD-14) — de enige toegestane hash.
  contentHash       String   @map("content_hash") @db.VarChar(64)
  cropPath          String?  @map("crop_path") @db.VarChar(1000)
  // Evidence-contract (AD-13): bron-GTIN, bronbestand, bbox, methode, scores,
  // declaratie-uitkomst, embedding-modelversie, status-overgangen.
  evidence          Json     @default("{}")
  // Claim-semantiek (AD-15): hoogstens één niet-afgesloten batch. Nullable
  // kolom ZONDER FK-constraint — de FK-constraint volgt in de 13.4-migratie.
  promotionBatchId  String?  @map("promotion_batch_id") @db.Uuid
  // Gezet bij promotie (AD-3): verwijzing naar de aangemaakte ReferenceLogo.
  referenceLogoId   String?  @map("reference_logo_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  referenceLogo ReferenceLogo?       @relation(fields: [referenceLogoId], references: [id])
  embeddings    CandidateEmbedding[]
  // Claim-doel (AD-15): de niet-afgesloten batch die deze kandidaat claimt. De
  // FK-constraint wordt in de 13.4-migratie toegevoegd (13.2 liet de kolom
  // bewust constraint-loos). onDelete: SetNull — een verwijderde batch mag de
  // kandidaat niet meesleuren; hij valt terug naar een niet-geclaimde staat.
  promotionBatch PromotionBatch?     @relation(fields: [promotionBatchId], references: [id], onDelete: SetNull)

  @@unique([contentHash, t3777Code])
  @@index([status])
  @@index([t3777Code])
  @@index([promotionBatchId])
  @@index([createdAt(sort: Desc)])
  @@map("reference_candidates")
}

/// Schaduw-embedding van een kandidaat-referentie (Story 13.2, AD-5).
/// pgvector(512), door de API geschreven. Bij promotie 1:1 gekopieerd naar
/// ReferenceEmbedding — nooit herberekend (AD-3), zodat de poort exact meet wat
/// live gaat.
model CandidateEmbedding {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceCandidateId  String   @map("reference_candidate_id") @db.Uuid
  embedding             Unsupported("vector(512)")?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  referenceCandidate ReferenceCandidate @relation(fields: [referenceCandidateId], references: [id], onDelete: Cascade)

  @@index([referenceCandidateId])
  @@map("candidate_embeddings")
}

/// Hard-negative (Story 13.2, AD-12). Uitsluitend gevuld door menselijke
/// afkeuring (quarantaine-afkeuring 15.3, reviewstation-reject "geen keurmerk"
/// 14.1) — nominatie blokkeert op een hash die hier staat, zodat een afgekeurd
/// beeld nooit opnieuw genomineerd wordt. De contentHash is de canonieke
/// AD-14-hash en uniek.
model HardNegative {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentHash String   @unique @map("content_hash") @db.VarChar(64)
  t3777Code   String   @map("t3777_code") @db.VarChar(100)
  cropPath    String?  @map("crop_path") @db.VarChar(1000)
  reason      String
  evidence    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([t3777Code])
  @@index([createdAt(sort: Desc)])
  @@map("hard_negatives")
}

/// Nachtelijke promotie-batch van het referentie-vliegwiel (Story 13.4, AD-6/
/// AD-13/AD-15/AD-16). Uitsluitend de flywheel-worker maakt batches aan (AD-15).
/// Kandidaten worden via `promotionBatchId` aan hoogstens één niet-afgesloten
/// batch geclaimd. Een batch is "afgesloten" zodra status ≠ `pending`.
///
/// `gateResults` bewaart per poort-fase (drempel/cap/dedup/outlier/regressie)
/// een uitkomst-record (AD-13) zodat de fasen crash-recovery-idempotent zijn
/// (AD-12/AD-16) en de dashboards (15.2/15.3) ze kunnen tonen. De regressie-fase,
/// de promotie-transactie en quarantaine zijn Story 13.5 — deze story stopt bij
/// een batch die alle guardrails passeert en `pending` blijft met de fase
/// `regression: not-run` in `gateResults`.
///
/// `baselineMeasurement` is eigendom van 13.5 (AD-5-baseline op de gepasseerde
/// batch); hier alleen gedeclareerd (default `{}`) zodat de tabelvorm klopt.
model PromotionBatch {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Status-machine (AD-16): pending → passed | quarantined | rolled_back.
  // Geen Prisma-enum (patroon ArtworkReviewItem.status / ReferenceCandidate.status).
  status              String    @default("pending") @db.VarChar(20)
  // Poort-uitkomsten per fase (AD-13). Vorm: { [phase]: { phase, startedAt,
  // finishedAt, outcome, rejectedCandidateIds, details } }.
  gateResults         Json      @default("{}") @map("gate_results")
  // AD-5-baseline op de gepasseerde batch — gevuld door 13.5. Nullable: een
  // pending/quarantined batch heeft (nog) geen baseline.
  baselineMeasurement Json?     @map("baseline_measurement")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Gezet zodra de batch afgesloten wordt (status ≠ pending).
  closedAt            DateTime? @map("closed_at") @db.Timestamptz

  // Relations: de kandidaten die deze batch claimde.
  candidates ReferenceCandidate[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("promotion_batches")
}

// ============================================
// GOLD-SET (Epic 13, Story 13.3, AD-4/AD-13)
// ============================================

/// Beheerde goudstandaard voor de regressietest (13.5) — de vervanger van de
/// bevroren JSON-snapshots in tests/validation/. Immutable (AD-13, FR-10):
/// records worden NOOIT ge-update op inhoudskolommen en NOOIT verwijderd; de
/// ENIGE toegestane mutatie is het zetten van `replacedById` op het OUDE record
/// bij vervanging.
///
/// Ketenresolutie (AD-4): de actieve gold-set heeft exact één canonieke
/// definitie — uitsluitend records zónder opvolger (`replacedById IS NULL`).
/// Geen keten-traversal: vervanging zet `replacedById` op het oude record, dus
/// één WHERE-clausule volstaat. Resolutie leeft uitsluitend in `apps/api`
/// (`services/flywheel/gold-set.ts`); de ml-service leest deze tabel NOOIT zelf
/// en krijgt de geresolvede set als request-payload (13.5).
///
/// Twee bronniveaus (zie migratie-docblock 0013):
///   - crop-niveau  : de 91 oogstrun-records — `cropPath` gevuld, evidence met
///                    gtin/confidence/method/sourceFile/bbox. De 13.5-eval
///                    consumeert UITSLUITEND deze crop-records.
///   - GTIN-niveau  : de 74 declared-marks-records — per (gtin, code) één record
///                    ECHT met `cropPath NULL` (variance: declaratie-anker).
///
/// LET OP (14.1-afstempunt): er is BEWUST geen constraint die
/// `replaced_by_id = id` blokkeert — de self-tombstone-undo van 14.1 steunt
/// hierop.
model GoldSetRecord {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Label ECHT/VALS als VarChar (géén Prisma-enum — patroon ArtworkReviewItem.status).
  label        String    @db.VarChar(20)
  t3777Code    String    @map("t3777_code") @db.VarChar(100)
  // Nullable: GTIN-niveau declaratie-records hebben geen crop (variance, AD-4).
  cropPath     String?   @map("crop_path") @db.VarChar(1000)
  // Herkomst: 'gold-set-oogstrun' | 'declared-marks-goldset' (dedup-sleutel per bron).
  source       String    @db.VarChar(100)
  // Wie de (vervangings)beslissing nam — nullable voor de eenmalige seed.
  decidedBy    String?   @map("decided_by") @db.VarChar(255)
  // Zelf-FK: gezet op het OUDE record bij vervanging (AD-4). Nullable = actief.
  replacedById String?   @map("replaced_by_id") @db.Uuid
  // Volledige bron-evidence zodat niets van de JSON verloren gaat (AD-13):
  // bron-id, gtin, confidence, method, sourceFile, bbox, codes.
  evidence     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations (self-FK). GEEN cascade — records zijn immutable; de FK verwijst
  // het oude record naar zijn opvolger.
  replacedBy   GoldSetRecord?  @relation("GoldSetReplacement", fields: [replacedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replaces     GoldSetRecord[] @relation("GoldSetReplacement")

  // Actieve-set-query = WHERE replaced_by_id IS NULL → index op replacedById.
  @@index([replacedById])
  @@index([t3777Code])
  @@index([createdAt(sort: Desc)])
  @@map("gold_set_records")
}

// ============================================
// SYSTEM SETTINGS (Epic 13, Story 13.6, AD-11)
// ============================================

/// Minimale, generieke key/value-store voor persistente systeeminstellingen
/// (Story 13.6, AD-11). De ENIGE bron van waarheid voor:
///   - `flywheel.paused`       — persistente pauze-stand (herstart heft niet op).
///   - `flywheel.baselineStale`— baseline-invalidatie-marker (AD-5): élke mutatie
///                               van de actieve referentieset buiten batch-promotie
///                               om markeert de baseline verouderd; de volgende
///                               poortrun leest + reset via `consumeBaselineStale`.
///   - `flywheel.autoPauseStreak` — teller opeenvolgende quarantaines (K=2-stilstand).
///
/// Bewust minimaal (AD-11: "nieuwe, minimale key/value-tabel"): geen typering per
/// key op DB-niveau — de vorm van `value` is een applicatie-contract in
/// `services/flywheel/pause.ts` resp. `baseline.ts`. `updatedBy` legt vast wie de
/// laatste mutatie deed (AD-13-herleidbaarheid, o.a. pauze/hervatten).
model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.VarChar(255)

  @@map("system_settings")
}
