# Preparation contract. Copy outside the repository (chmod 600), fill every blank.
# Never commit real values. Validation does not authorize production execution.
# Image pair measured on ACC 2026-10-05; retain these together unchanged.
RELEASE_SHA=814f6cd396f63dada95411d51dda5dfae3205a6a
APP_IMAGE_DIGEST=sha256:dba4876ad8cc213da91bd08f52ce5751ec4b7b5c5d629b139981101ed6d87f2f
ML_IMAGE_DIGEST=sha256:bfd7f50e2b10e6dc4286d0ce0e0333f680bb78971f9fa348764691c462a82a2e
# New isolated resource name must start logo-production-; never reuse old volumes.
PRODUCTION_RESOURCE_NAME=
# Dedicated new hostname: do not set the old live hostname before route approval.
PRODUCTION_HOSTNAME=
COOLIFY_PROXY_NETWORK=
# Mounted StorageBox only; exact directory must end /PRODUCTION_RESOURCE_NAME/minio-data.
# Directory/mount/permissions preparation requires separate approval; not auto-created.
MINIO_DATA_PATH=
# New empty database only. Extensions/schema/roles/data are separate approved work.
POSTGRES_DB=
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
# Both URLs must point to postgres:5432 and POSTGRES_DB, with non-admin roles.
# Passwords must be URL-encoded; app and ML can use separate roles/passwords.
APP_DATABASE_URL=
ML_DATABASE_URL=
# Existing production authentication database (MySQL); separate from new PostgreSQL.
AUTH_DATABASE_URL=
# Explicit production HTTPS media service; must never fall back to ACC.
MEDIASERVER_DOMAIN=
# Root credentials are supplied exclusively to MinIO and bucket provisioning.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Nonroot account with private bucket RW and ListAllMyBuckets for ML health.
# Account/policy creation is separate approved provisioning, not auto-created.
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
JWT_SECRET=
COOKIE_SECRET=
PIPELINE_SERVICE_KEY=
CATALOG_API_BASE=https://catalog.xxtract.com
CATALOG_API_KEY=
GHS_REVIEW_INTERNAL_KEY=
GHS_REVIEW_BASE_URL=
GHS_REVIEW_API_KEY=
GHS_REVIEW_MODEL_A=
GHS_REVIEW_MODEL_B=
