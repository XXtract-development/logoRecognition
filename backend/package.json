{
  "name": "logo-recognition-backend",
  "version": "1.0.0",
  "description": "A++ Quality Backend for Logo Recognition System",
  "main": "app/main.py",
  "scripts": {
    "test": "jest --coverage --maxWorkers=4",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --maxWorkers=4 --ci --reporters=default --reporters=jest-junit",
    "test:unit": "jest --testPathPattern=unit --coverage",
    "test:integration": "jest --testPathPattern=integration --coverage",
    "test:coverage": "jest --coverage --coverageReporters=text-lcov | coveralls",
    "lint": "eslint app/**/*.js",
    "format": "prettier --write \"app/**/*.js\"",
    "audit": "npm audit --audit-level=high",
    "security": "npm audit fix && bandit -r app -ll"
  },
  "keywords": [
    "logo-recognition",
    "testing",
    "a++",
    "quality"
  ],
  "author": "A++ Development Team",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nyc": "^17.2.0",
    "prettier": "^3.4.2",
    "sharp": "^0.34.0",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "app/**/*.js",
      "!app/**/*.test.js"
    ]
  }
}