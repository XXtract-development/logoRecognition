        "uploaded_files": len(uploaded_files_db)
    }

@app.post("/api/v1/logos/upload")
async def upload_logos(
    request: Request,
    files: Optional[List[UploadFile]] = File(None),
    file: Optional[UploadFile] = File(None)
):
    """Real upload endpoint - saves actual files to disk"""
    print(f"Request headers: {dict(request.headers)}")

    # Handle both single file and multiple files
    file_list = []
    if files:
        file_list = files
        print(f"Received {len(files)} files via 'files' parameter")
    elif file:
        file_list = [file]
        print(f"Received 1 file via 'file' parameter")
    else:
        print("No files received")
        return {"error": "No files provided", "uploaded": 0, "results": []}

    results = []
    for i, upload_file in enumerate(file_list):
        print(f"Processing file {i}: {upload_file.filename}, content_type: {upload_file.content_type}")

        # Validate file type
        if not upload_file.content_type or not upload_file.content_type.startswith('image/'):
            print(f"Invalid file type: {upload_file.content_type}")
            continue

        # Generate unique file ID and filename
        file_id = str(uuid.uuid4())
        file_extension = Path(upload_file.filename).suffix.lower()
        if not file_extension:
            file_extension = '.jpg'  # default

        unique_filename = f"{file_id}{file_extension}"
        file_path = UPLOAD_DIR / unique_filename

        # Save file to disk
        content = await upload_file.read()
        with open(file_path, "wb") as buffer:
            buffer.write(content)

        # Generate URLs
        image_url = f"http://localhost:8000/static/{unique_filename}"

        # Store metadata
        file_metadata = {
            "original_filename": upload_file.filename,
            "unique_filename": unique_filename,
            "file_path": str(file_path),
            "content_type": upload_file.content_type,
            "size": len(content),
            "file_id": file_id
        }
        uploaded_files_db[file_id] = file_metadata

        results.append({
            "filename": upload_file.filename,
            "status": "success",
            "file_id": file_id,
            "message": "Upload successful - real implementation",
            "size": len(content),
            "url": image_url,
            "thumbnail": image_url,  # For now, same as main image
            "unique_filename": unique_filename
        })

    response = {"uploaded": len(results), "results": results, "status": "success"}
    print(f"Returning response: {response}")
    return response

@app.get("/api/v1/files/{file_id}")
async def get_file_info(file_id: str):
    """Get file metadata by ID"""
    if file_id not in uploaded_files_db:
        raise HTTPException(status_code=404, detail="File not found")

    metadata = uploaded_files_db[file_id]
    return {
        "file_id": file_id,
        "original_filename": metadata["original_filename"],
        "url": f"http://localhost:8000/static/{metadata['unique_filename']}",
        "size": metadata["size"],
        "content_type": metadata["content_type"]
    }


def _normalize_string(value: Any) -> Optional[str]:
    if not isinstance(value, str):
        return None
    trimmed = value.strip()
    return trimmed or None


def _validate_annotation_box(box: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    required_numeric = ["x", "y", "width", "height"]
    for key in required_numeric:
        value = box.get(key)
        if not isinstance(value, (int, float)):
            return None
        if key in {"width", "height"} and value <= 0:
            return None

    category = _normalize_string(box.get("category"))
    value = _normalize_string(box.get("value"))

    if not category or not value:
        return None

    box_id = box.get("id")
    if not box_id:
        return None

    normalized = {
        "id": box_id,
        "x": float(box.get("x")),
        "y": float(box.get("y")),
        "width": float(box.get("width")),
        "height": float(box.get("height")),
        "category": category,
        "value": value,
        "color": box.get("color"),
        "created": box.get("created"),
        "imageId": box.get("imageId"),
    }

    return normalized


@app.get("/api/v1/logos/{file_id}/annotations")
async def get_annotations(file_id: str):
    if file_id not in uploaded_files_db:
        raise HTTPException(status_code=404, detail="File not found")

    if file_id not in annotations_db:
        annotations_db[file_id] = _load_annotations_from_disk(file_id)

    return annotations_db[file_id]


@app.post("/api/v1/logos/{file_id}/annotations")
async def save_annotations(file_id: str, payload: Dict[str, Any]):
    if file_id not in uploaded_files_db:
        raise HTTPException(status_code=404, detail="File not found")

    annotations = payload.get("annotations", [])
    if not isinstance(annotations, list):
        raise HTTPException(status_code=400, detail="Invalid annotations payload")

    validated: List[Dict[str, Any]] = []
    seen_pairs = set()
    for box in annotations:
        if not isinstance(box, dict):
            raise HTTPException(status_code=400, detail="Invalid bounding box data")
        normalized = _validate_annotation_box(box)
        if not normalized:
            raise HTTPException(status_code=400, detail="Each bounding box must include valid category and value")

        pair = (normalized["category"].lower(), normalized["value"].lower())
        if pair in seen_pairs:
            raise HTTPException(status_code=400, detail=f"Duplicate category/value pair detected: {normalized['category']} - {normalized['value']}")
        seen_pairs.add(pair)

        validated.append(normalized)

    _persist_annotations(file_id, validated)

    return {"status": "success", "count": len(validated)}


