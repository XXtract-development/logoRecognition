"""
Real implementation FastAPI app with actual image serving
"""
from fastapi import FastAPI, File, UploadFile, HTTPException, Request, Form, WebSocket
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles
from fastapi.responses import FileResponse, JSONResponse
from typing import List, Optional, Union, Dict, Any
import json
import os
import uuid
import shutil
from pathlib import Path
import base64
from datetime import datetime
import sys
from pathlib import Path
sys.path.append(str(Path(__file__).parent.parent))
from app.routers import health

app = FastAPI(title="Logo Recognition System - Real Implementation")

# Create uploads directory
UPLOAD_DIR = Path("uploads")
UPLOAD_DIR.mkdir(exist_ok=True)

# Serve static files
app.mount("/static", StaticFiles(directory=str(UPLOAD_DIR)), name="static")

# CORS for frontend
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:3000", "http://localhost:4001"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Include routers
app.include_router(health.router)

# In-memory storage for uploaded files metadata
uploaded_files_db: Dict[str, Dict[str, Any]] = {}
annotations_db: Dict[str, Dict[str, Any]] = {}
training_jobs: Dict[str, Dict[str, Any]] = {}
TRAINING_JOBS_FILE = UPLOAD_DIR / "training_jobs.json"


def _annotation_file_path(file_id: str) -> Path:
    return UPLOAD_DIR / f"{file_id}.annotations.json"


def _load_annotations_from_disk(file_id: str) -> Dict[str, Any]:
    file_path = _annotation_file_path(file_id)
    if file_path.exists():
        try:
            with open(file_path, "r", encoding="utf-8") as handle:
                data = json.load(handle)
                if isinstance(data, dict) and "annotations" in data:
                    return data
        except Exception as exc:  # pragma: no cover - defensive fallback
            print(f"Failed to load annotations for {file_id}: {exc}")
    return {"annotations": []}


def _persist_annotations(file_id: str, annotations: List[Dict[str, Any]]) -> None:
    payload = {"annotations": annotations}
    annotations_db[file_id] = payload
    file_path = _annotation_file_path(file_id)
    try:
        with open(file_path, "w", encoding="utf-8") as handle:
            json.dump(payload, handle)
    except Exception as exc:  # pragma: no cover - defensive fallback
        print(f"Failed to persist annotations for {file_id}: {exc}")


def _load_training_jobs() -> None:
    if not TRAINING_JOBS_FILE.exists():
        return

    try:
        with open(TRAINING_JOBS_FILE, "r", encoding="utf-8") as handle:
            data = json.load(handle)
            if isinstance(data, list):
                for job in data:
                    if isinstance(job, dict) and job.get("id"):
                        training_jobs[job["id"]] = job
                        _update_training_progress(job)
    except Exception as exc:  # pragma: no cover - defensive fallback
        print(f"Failed to load training jobs: {exc}")


def _persist_training_jobs() -> None:
    try:
        with open(TRAINING_JOBS_FILE, "w", encoding="utf-8") as handle:
            json.dump(list(training_jobs.values()), handle)
    except Exception as exc:  # pragma: no cover - defensive fallback
        print(f"Failed to persist training jobs: {exc}")


def _collect_dataset() -> Dict[str, Any]:
    dataset = []
    total_annotations = 0

    for file_id, metadata in uploaded_files_db.items():
        data = annotations_db.get(file_id) or _load_annotations_from_disk(file_id)
        annotations = data.get("annotations", [])
        dataset.append({
            "file_id": file_id,
            "filename": metadata["original_filename"],
            "annotations": annotations
        })
        total_annotations += len(annotations)

    return {
        "items": dataset,
        "total_images": len(dataset),
        "total_annotations": total_annotations
    }


_load_training_jobs()


def _update_training_progress(job: Dict[str, Any]) -> None:
    if job["status"] != "running":
        return

    elapsed = datetime.utcnow().timestamp() - job["start_ts"]
    progress = min(1.0, elapsed / job["duration_seconds"])
    job["progress"] = round(progress * 100, 2)

    if progress >= 1.0:
        job["status"] = "completed"
        job["finished_at"] = datetime.utcnow().isoformat()
        _persist_training_jobs()


def _serialize_training_job(job: Dict[str, Any]) -> Dict[str, Any]:
    _update_training_progress(job)
    summary = {
        "id": job["id"],
        "status": job["status"],
        "progress": job.get("progress", 0),
        "created_at": job["created_at"],
        "dataset": job["dataset"],
    }
    if job["status"] == "completed":
        summary["finished_at"] = job.get("finished_at")

    return summary

