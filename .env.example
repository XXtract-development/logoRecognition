# ============================================
# Logo Recognition - Environment Variables
# ============================================
# Copy this file to .env and fill in production values.
# Defaults shown here are suitable for local development.

# Node
NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# Logging
LOG_LEVEL=debug  # debug | info | warn | error (production default: info)

# ============================================
# Database (PostgreSQL + pgvector)
# ============================================
# Required extensions: pgvector, pg_trgm, btree_gin, btree_gist
DATABASE_URL=postgresql://user:password@localhost:5432/logo_recognition

# ============================================
# Authentication
# ============================================
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=24h
COOKIE_SECRET=change-me-in-production-min-32-chars

# ============================================
# MinIO (S3-compatible Object Storage)
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============================================
# ML Service (FastAPI backend)
# ============================================
ML_SERVICE_URL=http://localhost:8001

# ============================================
# Redis — BullMQ queue backend + cache (Epic 9)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Pipeline Service Account (Epic 9, Story 9.1)
# ============================================
# Used by scheduled callers (cron/worker) to authenticate against secured
# pipeline endpoints. Must be at least 32 random characters. Set as a secret
# in Coolify — never hardcode in compose files.
# Generate: openssl rand -hex 32
PIPELINE_SERVICE_KEY=

# ============================================
# CORS
# ============================================
# Comma-separated origins for API and Socket.IO
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ============================================
# API Key (optional, for external API access)
# ============================================
API_KEY=

# ============================================
# Monitoring (optional)
# ============================================
SENTRY_DSN=
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============================================
# Frontend (Vite - apps/web)
# ============================================
# These are used in apps/web/vite.config.ts for dev proxy targets
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Playwright E2E tests
BASE_URL=http://localhost:5173
