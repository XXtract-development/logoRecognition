# ============================================
# Logo Recognition - Environment Variables
# ============================================
# Copy this file to .env and fill in production values.
# Defaults shown here are suitable for local development.

# Node
NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# Logging
LOG_LEVEL=debug  # debug | info | warn | error (production default: info)

# ============================================
# Database (PostgreSQL + pgvector)
# ============================================
# Required extensions: pgvector, pg_trgm, btree_gin, btree_gist
DATABASE_URL=postgresql://user:password@localhost:5432/logo_recognition

# ============================================
# Authentication
# ============================================
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=24h
COOKIE_SECRET=change-me-in-production-min-32-chars

# ============================================
# MinIO (S3-compatible Object Storage)
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============================================
# ML Service (FastAPI backend)
# ============================================
ML_SERVICE_URL=http://localhost:8001

# ============================================
# Redis — BullMQ queue backend + cache (Epic 9)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Pipeline Service Account (Epic 9, Story 9.1)
# ============================================
# Used by scheduled callers (cron/worker) to authenticate against secured
# pipeline endpoints. Must be at least 32 random characters. Set as a secret
# in Coolify — never hardcode in compose files.
# Generate: openssl rand -hex 32
PIPELINE_SERVICE_KEY=

# ============================================
# Flywheel mismatch-registratie (Story 16.1, FR-14, AD-8)
# ============================================
# Kruischeck-nominatie/mismatch-registratie (12.8-pad). VEREIST óók de hoofdvlag
# FLYWHEEL_NOMINATION_ENABLED (AD-8). Beide default uit → verse deploy schrijft
# NIETS en de verify-declared-response richting n8n blijft byte-gelijk.
FLYWHEEL_KRUISCHECK_NOMINATION_ENABLED=false

# ============================================
# Flywheel structureel-drempel — declared-not-found → werkvoorraad (Story 16.2, FR-15)
# ============================================
# N = minimaal aantal declared-not-found-events; M = minimaal aantal
# VERSCHILLENDE GTINs waarover die events verdeeld zijn, vóór een T3777-code
# werkvoorraad wordt (bootstrap-wachtrij / aanvul-signaal). Defaults 10 / 5.
FLYWHEEL_STRUCTURAL_N=10
FLYWHEEL_STRUCTURAL_M=5

# ============================================
# Declared-values verificatie — kruischeck-endpoint voor n8n (Story 12.8)
# ============================================
# TTL (seconden) van de verify-declared run-state in Redis (geen DB/migratie,
# AC7). n8n pollt binnen dit venster; een verlopen/onbekende runId → 404.
# Default 86400 (24 uur).
VERIFY_RUN_STATE_TTL_S=86400

# ============================================
# Flywheel controle-cohort (Story 16.4, SM-3, AD-6)
# ============================================
# Maandelijkse herverwerking van het VASTE controle-cohort (~100 GTINs) op de
# queue `flywheel` (Job Scheduler, upsertJobScheduler). Meet de CONFIRMED-ratio-
# trend zodat groei toe te schrijven is aan referentiegroei, niet aan productmix.
# Cadans: default 1e van de maand 03:23 Europe/Amsterdam (nachtelijk, buiten de
# dagelijkse promotielus). Cron-formaat.
FLYWHEEL_COHORT_CRON=23 3 1 * *
# Time-box (wall-clock seconden) voor één cohortrun. Default 3600 (1 uur).
# ~100 GTINs × ~28s lokalisatie ≈ 45–50 min; bij overschrijding stopt de run
# netjes en vallen de resterende GTINs als uitval (de definitie blijft ongewijzigd).
FLYWHEEL_COHORT_MAX_SECONDS=3600
# Tempering: pauze (ms) tussen twee GTIN-herverwerkingen binnen een cohortrun.
# Default 0 (de flywheel-worker draait al serieel, concurrency 1). Verhoog om de
# live-detectie/harvest nóg meer lucht te geven.
FLYWHEEL_COHORT_GTIN_DELAY_MS=0

# --- Bootstrap-run per lege klasse (Story 17.1, FR-12) ---
# De job `flywheel-bootstrap` (queue `flywheel`, concurrency 1) vult een lege
# klasse (T3777-code zonder actieve referenties) met echte crops uit declarerende
# producten. Het GS1-gids-logo is UITSLUITEND zoekzaad (NFR-6). Valt onder de
# hoofdvlag FLYWHEEL_NOMINATION_ENABLED (AD-8) en de pauzestand (AD-11).
# Cosine-drempel tegen de zaad-embedding: een regio matcht pas ≥ deze waarde.
# Default 0,93 (bewust strenger dan de promotiedrempel 0,90 — bootstrap zoekt
# zonder actieve referenties en moet conservatief zijn).
FLYWHEEL_BOOTSTRAP_THRESHOLD=0.93
# Run-budget: max aantal GTINs per run (beschermt tegen ~28s/beeld-lokalisatie —
# 200 × ~28s ≈ 1,5 uur). Het restant blijft `wachtend` voor een volgende run.
FLYWHEEL_BOOTSTRAP_RUN_BUDGET=200
# Time-box (wall-clock seconden) per run. Default 1800 (30 min); bij overschrijding
# stopt de run netjes en blijft de niet-verwerkte klasse `wachtend`.
FLYWHEEL_BOOTSTRAP_MAX_SECONDS=1800

# --- GLN-restant-re-import (Story 18.2, terugval-route AD-7, NFR-3) ---
# Handmatig gestart driver-script (apps/api/scripts/gln-reimport-restant.ts) dat het
# GLN-restant NA Story 18.1 (gln IS NULL + gezette reden) alsnog via het bestaande
# 8-3O-re-importmechanisme van een GLN voorziet. GEDOSEERD/CPU-getemperd (les
# 2026-06-15: ongetemperde bulk deed de frontend-health-check timeouten): elke batch
# draait als één import-run en het script wacht op afronding vóór de volgende batch.
# Batch-grootte (aantal GTINs per re-import-run). Conservatieve default 25.
FLYWHEEL_GLN_REIMPORT_BATCH_SIZE=25
# Pauze (ms) tussen twee batches. Conservatieve default 30000 (30s); verhoog om de
# live-detectie/import nóg meer lucht te geven.
FLYWHEEL_GLN_REIMPORT_PAUSE_MS=30000

# ============================================
# CORS
# ============================================
# Comma-separated origins for API and Socket.IO
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ============================================
# API Key (optional, for external API access)
# ============================================
API_KEY=

# ============================================
# Monitoring (optional)
# ============================================
SENTRY_DSN=
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============================================
# Frontend (Vite - apps/web)
# ============================================
# These are used in apps/web/vite.config.ts for dev proxy targets
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Playwright E2E tests
BASE_URL=http://localhost:5173
